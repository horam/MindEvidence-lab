{
  "openapi": "3.1.0",
  "info": {
    "title": "MindEvidence Lab API",
    "description": "Backend for MindEvidence Lab, an educational tool. **All patient data is synthetic.**\n\n**Access policy (development only):** there is no authentication yet. Session endpoints identify the caller by the\nunverified `X-Dev-User` header and enforce ownership against it, but anyone can claim any identity. Do not treat these\nendpoints as secure. They return 503 unless `APP_ENV=development`. Real sign-in arrives in Batch 04.\n\nErrors always use `{\"error\": {\"code\", \"message\", \"details\"}}`. No RAG, LLM or OAuth features exist yet.",
    "version": "0.2.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness and database check",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/patients": {
      "get": {
        "tags": [
          "patients"
        ],
        "summary": "List synthetic patients",
        "operationId": "list_patients_api_patients_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Page size",
              "default": 50,
              "title": "Limit"
            },
            "description": "Page size"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100000,
              "minimum": 0,
              "description": "Rows to skip",
              "default": 0,
              "title": "Offset"
            },
            "description": "Rows to skip"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_PatientSummary_"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        }
      }
    },
    "/api/patients/{patient_id}": {
      "get": {
        "tags": [
          "patients"
        ],
        "summary": "Full synthetic patient profile",
        "operationId": "get_patient_api_patients__patient_id__get",
        "parameters": [
          {
            "name": "patient_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^P-\\d{3}$",
              "description": "Synthetic patient ID, P-001 to P-010",
              "examples": [
                "P-001"
              ],
              "title": "Patient Id"
            },
            "description": "Synthetic patient ID, P-001 to P-010"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PatientDetail"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        }
      }
    },
