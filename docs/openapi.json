        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "FactorOut": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "trigger",
              "risk_factor",
              "protective_factor",
              "observed_behavior"
            ],
            "title": "Kind"
          },
          "domain": {
            "type": "string",
            "title": "Domain"
          },
          "description": {
            "type": "string",
            "title": "Description"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "domain",
          "description"
        ],
        "title": "FactorOut"
      },
      "HealthOut": {
        "properties": {
          "status": {
            "type": "string",
