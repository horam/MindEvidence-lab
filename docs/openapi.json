    "/api/sessions": {
      "get": {
        "tags": [
          "sessions (development-only access policy)"
        ],
        "summary": "List the caller's sessions",
        "operationId": "list_sessions_api_sessions_get",
        "parameters": [
          {
            "name": "patient_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^P-\\d{3}$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Patient Id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Page size",
              "default": 50,
              "title": "Limit"
            },
            "description": "Page size"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100000,
              "minimum": 0,
              "description": "Rows to skip",
              "default": 0,
              "title": "Offset"
            },
            "description": "Rows to skip"
          },
          {
            "name": "X-Dev-User",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.@-]{1,64}$",
              "description": "DEV ONLY. Claimed identity; not verified. Replaced by real authentication in Batch 04.",
              "default": "dev-user",
              "title": "X-Dev-User"
            },
            "description": "DEV ONLY. Claimed identity; not verified. Replaced by real authentication in Batch 04."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_SessionOut_"
                }
              }
            }
          },
          "503": {
            "description": "Disabled outside APP_ENV=development until authentication exists"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        }
      },
      "post": {
        "tags": [
          "sessions (development-only access policy)"
        ],
        "summary": "Create a session",
        "operationId": "create_session_api_sessions_post",
        "parameters": [
          {
            "name": "X-Dev-User",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.@-]{1,64}$",
              "description": "DEV ONLY. Claimed identity; not verified. Replaced by real authentication in Batch 04.",
              "default": "dev-user",
              "title": "X-Dev-User"
            },
            "description": "DEV ONLY. Claimed identity; not verified. Replaced by real authentication in Batch 04."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOut"
                }
              }
            }
          },
          "503": {
            "description": "Disabled outside APP_ENV=development until authentication exists"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        }
      }
    },
    "/api/sessions/{session_id}/messages": {
