          "end_date",
          "status",
          "outcome_note"
        ],
        "title": "InterventionOut"
      },
      "MessageOut": {
        "properties": {
          "message_id": {
            "type": "integer",
            "title": "Message Id"
          },
          "session_id": {
            "type": "string",
            "format": "uuid",
