              "default": 0,
              "title": "Offset"
            },
            "description": "Rows to skip"
          },
          {
            "name": "X-Dev-User",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.@-]{1,64}$",
              "description": "DEV ONLY. Claimed identity; not verified. Replaced by real authentication in Batch 04.",
              "default": "dev-user",
              "title": "X-Dev-User"
            },
            "description": "DEV ONLY. Claimed identity; not verified. Replaced by real authentication in Batch 04."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_MessageOut_"
                }
              }
            }
